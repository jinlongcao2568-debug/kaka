# Copy outside the repository. This file contains references, never secret values.

KAKA_DEPLOYMENT_TENANT_ID=replace-tenant
KAKA_DEPLOYMENT_INSTANCE_ID=primary
KAKA_PRIVATE_HOSTNAME=service.example.com
KAKA_PUBLIC_HOSTNAME=service.example.com
KAKA_OPERATOR_HOSTNAME=operator.service.internal
KAKA_OPERATOR_TLS_PORT=18443
KAKA_PUBLIC_UPSTREAM_PORT=18080

KAKA_PRIVATE_PRINCIPALS_FILE=/srv/kaka-production/secrets/internal-principals.json
KAKA_PRIVATE_POSTGRES_PASSWORD_FILE=/srv/kaka-production/secrets/postgres-password
KAKA_CUSTOMER_PORTAL_SIGNING_KEY_FILE=/srv/kaka-production/secrets/customer-portal-signing-key
KAKA_DELIVERY_WEBHOOK_SECRET_FILE=/srv/kaka-production/secrets/delivery-webhook-secret
KAKA_STRIPE_SECRET_KEY_FILE=/srv/kaka-production/secrets/stripe-live-secret-key
KAKA_STRIPE_WEBHOOK_SECRET_FILE=/srv/kaka-production/secrets/stripe-webhook-secret
KAKA_STRIPE_ACCOUNT_ID=acct_replace_with_expected_account
KAKA_PROVIDER_EVIDENCE_SIGNING_KEY_FILE=/srv/kaka-production/secrets/provider-evidence-signing-key
KAKA_ALERT_SIGNING_SECRET_FILE=/srv/kaka-production/secrets/alert-signing-secret

KAKA_DELIVERY_PROVIDER_LIVE_EVIDENCE_FILE=/srv/kaka-production/evidence/delivery-provider-live.json
KAKA_PAYMENT_PROVIDER_LIVE_EVIDENCE_FILE=/srv/kaka-production/evidence/payment-provider-live.json
KAKA_DELIVERY_PROVIDER_OPERATOR_ACTION_REF=replace-delivery-operator-action-ref
KAKA_PAYMENT_PROVIDER_OPERATOR_ACTION_REF=replace-payment-operator-action-ref

KAKA_API_IMAGE_REPOSITORY=registry.example.com/kaka/api
KAKA_API_IMAGE_DIGEST=sha256:replace-with-api-image-digest
KAKA_WORKER_IMAGE_REPOSITORY=registry.example.com/kaka/worker
KAKA_WORKER_IMAGE_DIGEST=sha256:replace-with-worker-image-digest
KAKA_BROWSER_WORKER_IMAGE_REPOSITORY=registry.example.com/kaka/browser-worker
KAKA_BROWSER_WORKER_IMAGE_DIGEST=sha256:replace-with-browser-worker-image-digest
KAKA_BACKUP_TOOLS_IMAGE_REPOSITORY=registry.example.com/kaka/backup-tools
KAKA_BACKUP_TOOLS_IMAGE_DIGEST=sha256:replace-with-backup-tools-image-digest
KAKA_POSTGRES_IMAGE_REPOSITORY=docker.io/library/postgres
KAKA_POSTGRES_IMAGE_DIGEST=sha256:replace-with-postgres-image-digest
KAKA_CADDY_IMAGE_REPOSITORY=docker.io/library/caddy
KAKA_CADDY_IMAGE_DIGEST=sha256:replace-with-caddy-image-digest

KAKA_RELEASE_VERSION=replace-release-version
KAKA_PRODUCTION_RELEASE_ID=replace-release-id
KAKA_PRODUCTION_RELEASE_MODE=CANARY
KAKA_PRODUCTION_RELEASE_WINDOW_START_AT=2026-08-01T00:00:00Z
KAKA_PRODUCTION_RELEASE_WINDOW_END_AT=2026-08-01T04:00:00Z
KAKA_PRODUCTION_CANARY_CUSTOMER_LIMIT=3
KAKA_PRODUCTION_KILL_SWITCH=true

KAKA_PRIVATE_BACKUP_ROOT=/srv/kaka-production/backups
KAKA_PRODUCTION_BACKUP_DIRECTORY=/srv/kaka-production/backups/replace-backup-id
KAKA_PRODUCTION_RESTORE_REPORT_FILE=/srv/kaka-production/evidence/replace-restore-report.json
KAKA_PRODUCTION_ROLLBACK_REPORT_FILE=/srv/kaka-production/evidence/replace-rollback-report.json

KAKA_ALERT_WEBHOOK_URL=https://alerts.example.com/kaka
KAKA_ALERT_ALLOWED_HOSTS=alerts.example.com

KAKA_API_PUBLIC_REQUESTS_PER_MINUTE=600
KAKA_API_PUBLIC_CONCURRENCY_PER_CLIENT=8
