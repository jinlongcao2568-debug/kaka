{
  "contract_id": "model_provider_runtime_contract",
  "contract_version": "1.1.0",
  "status": "ACTIVE_INTERNAL_SHADOW",
  "runtime_mode": {
    "default": "OFF",
    "allowed": ["OFF", "INTERNAL_SHADOW", "EMERGENCY_OFF"],
    "customer_or_formal_live_mode_allowed": false,
    "automatic_tool_calling_allowed": false,
    "formal_object_write_allowed": false
  },
  "allowed_task_kinds": [
    "CANDIDATE_EXTRACTION",
    "EVIDENCE_SUMMARY",
    "REVIEW_EXPLANATION",
    "DRAFT_COPY"
  ],
  "allowed_input_classifications": ["PUBLIC", "INTERNAL_SANITIZED"],
  "required_runtime_controls": [
    "explicit_internal_shadow_mode",
    "exact_provider_and_model",
    "api_key_secret_file",
    "exact_https_host_allowlist",
    "shadow_approval_state_approved",
    "shadow_audit_ref",
    "eval_state_passed",
    "emergency_kill_switch",
    "bounded_timeout_and_retries",
    "store_false",
    "strict_json_schema",
    "request_and_response_hash",
    "usage_and_latency_trace",
    "transport_evidence_classification",
    "unsafe_output_rejection",
    "deterministic_content_free_fallback",
    "human_review_required"
  ],
  "forbidden_input_keys": [
    "password",
    "secret",
    "token",
    "api_key",
    "cookie",
    "authorization",
    "credential",
    "provider_credential",
    "private_contact",
    "customer_personal_data",
    "id_card_number",
    "bank_account",
    "raw_governed_document",
    "chain_of_thought"
  ],
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["summary", "field_candidates", "review_flags", "draft_text"],
    "properties": {
      "summary": {"type": "string", "maxLength": 4000},
      "field_candidates": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_name", "field_value", "source_ref", "confidence"],
          "properties": {
            "field_name": {"type": "string", "maxLength": 160},
            "field_value": {"type": "string", "maxLength": 4000},
            "source_ref": {"type": "string", "maxLength": 512},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      },
      "review_flags": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "maxLength": 160},
            "message": {"type": "string", "maxLength": 2000}
          }
        }
      },
      "draft_text": {"type": "string", "maxLength": 8000}
    }
  },
  "provider_protocol": {
    "kind": "OPENAI_RESPONSES_COMPATIBLE",
    "endpoint_suffix": "/responses",
    "request_store": false,
    "structured_output": "text.format.json_schema.strict",
    "tools": "DISABLED"
  },
  "runtime_failure_behavior": {
    "provider_timeout_network_rate_limit_refusal_invalid_schema_untraceable_or_unsafe_output": "FALLBACK_DETERMINISTIC_REVIEW_REQUIRED",
    "restricted_input_invalid_request_or_provider_disabled": "FAIL_CLOSED_WITHOUT_FALLBACK",
    "fallback_reuses_model_content": false,
    "fallback_can_write_fact_or_customer_output": false,
    "quality_evaluation_contract_ref": "contracts/model/model_quality_evaluation_contract.json"
  },
  "policy_refs": [
    "contracts/model/model_usage_policy.json",
    "contracts/model/model_release_gates.json",
    "contracts/model/prompt_policy_catalog.json",
    "contracts/model/output_target_matrix.json",
    "contracts/model/model_quality_evaluation_contract.json"
  ]
}
